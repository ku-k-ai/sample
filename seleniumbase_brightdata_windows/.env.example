# Copy to .env. Values are literal; @ : # $ % & + and = need no URL encoding.
# Use your zone's proxy endpoint, NOT Browser API/CDP/Web Unlocker API credentials.
BRD_PROXY_HOST=CHANGE_ME_HOST
BRD_PROXY_PORT=CHANGE_ME_PORT
BRD_PROXY_USER=CHANGE_ME_USERNAME
BRD_PROXY_PASS=CHANGE_ME_PASSWORD
# Connection from local relay to upstream proxy; match your provider endpoint.
BRD_PROXY_SCHEME=http
BRD_PROXY_CA_FILE=

TARGET_URL=https://geo.brdtest.com/welcome.txt
EXPECT_TEXT=
EXPECT_SELECTOR=

BROWSER_BINARY=cft
BROWSER_MODE=standard
HEADLESS=0
PAGE_TIMEOUT=45
RUN_TIMEOUT=180
SAVE_PAGE_ARTIFACTS=0
ARTIFACT_DIR=artifacts
